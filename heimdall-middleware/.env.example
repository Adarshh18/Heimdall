# ── Heimdall — Environment Variables ─────────────────────────────────────────
# Copy to .env and fill in your keys.
#
# Get Gemini:  https://ai.google.dev          (free, 1M TPM/day)
# Get Groq:    https://console.groq.com       (free, very fast)
# Get Mistral: https://console.mistral.ai     (free tier)

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Multi-LLM backend URL (run multi-llm-backend separately)
MULTI_LLM_BACKEND_URL=http://localhost:8001

# Redis (optional — USE_FAKE_REDIS=true works without a Redis server)
USE_FAKE_REDIS=true
REDIS_URL=redis://localhost:6379

# Server
PORT=8000
