# ── Multi-LLM Backend — Environment Variables ─────────────────────────────
# Copy to .env and fill in your keys.
#
# Get Gemini key:  https://ai.google.dev          (free, 1M TPM/day)
# Get Groq key:    https://console.groq.com       (free tier, very fast)
# Get Mistral key: https://console.mistral.ai     (free tier)

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: override the system prompt sent to all LLMs
# DEFAULT_SYSTEM=You are a helpful, concise assistant. Answer clearly and briefly.
